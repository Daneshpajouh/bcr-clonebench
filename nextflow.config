// bcr-clonebench settings. Images are pinned by digest in images.lock;
// 'make pin' fills it on a machine with Docker.
manifest {
    name = 'bcr-clonebench'
    description = 'Known-answer benchmark of BCR clonal grouping methods'
    nextflowVersion = '>=24.04'
}

params {
    n_founders = 2000            // clonal families per mutation level
    seed = 20261019
    levels = ['low', 'medium', 'high']
    methods = ['changeo', 'identical', 'hierarchical', 'spectral', 'spectral_vj']
    mean_family_size = 4.0
    error_rates = [0.0, 0.001, 0.005]   // sequencing error per base, each run at every level
    fallback_threshold = 0.16    // used, and reported, only when SHazaM finds no threshold
    threshold_override = null    // mutation test only (make mutation-tests): a fixed, deliberately wrong threshold
    reference_dir = "${projectDir}/reference"
    outdir = 'results'
    lineage_simulator = 'partis'   // or 'inrepo'
    lineage_mode = 'partis'        // or 'bcr-phylo' (partis's bcr-phylo-run.py)
    bcr_phylo_args = ''
    mutation_multiplier = [low: 0.25, medium: 1.0, high: 2.0]   // partis --mutation-multiplier per level
    // A harder setting (Director ruling 2026-10-20): each level also runs as <level>_shared, where every family
    // uses one V allele, one J allele and one junction length, so unrelated families look alike and precision can
    // fall. Both partis options were read from partis simulate --help in the pinned image (CI run 18 tool-help):
    // --only-genes (colon-separated) and --allowed-cdr3-lengths (nucleotides, both conserved codons included, as in
    // the AIRR junction). partis only (the in-repo generator has no such switch).
    shared_vj = false
    shared_vj_genes = 'IGHV3-23*01:IGHJ4*02'
    shared_junction_length = 48
    suite_image = ''
    immunesim_image = ''
    partis_image = ''
}

process {
    cpus = 2
    memory = '4 GB'
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    test {
        params.n_founders = 60
        params.levels = ['low', 'high']
        params.error_rates = [0.0, 0.005]
        params.shared_vj = true
    }
}
